    { "src": "./icons/app-icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Project", "url": "./#/projects", "icons": [{ "src": "./icons/app-icon-192.svg", "sizes": "192x192" }] }
  ]
